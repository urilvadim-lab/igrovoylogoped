/* Александра Карачинцева — сайт, версия 4.
   Палитра из её презентаций: бирюзовый (доверие) + терракота (действие) + кремовый + солнечно-жёлтый (упражнения).
   Тон: серьёзно и тепло. Глиняные герои из игр используются точечно как проводники. Версия 1: _versions\v1_playful */
:root{
  --bg:#fbf5ea;--card:#fff;--ink:#1d2b33;--muted:#5d6a70;--line:rgba(29,43,51,.1);
  --teal:#1f5b5e;--teal-d:#164549;--teal-soft:#e0eeea;
  --terra:#d9703c;--terra-d:#bf5a28;--terra-soft:#fbe5d6;
  --sun:#f4c24d;--sun-soft:#fdf0c9;--sand:#f3e7d3;
  --radius:24px;--shadow:0 22px 48px -28px rgba(29,43,51,.4);--ease:cubic-bezier(.22,1,.36,1);
  --fh:"Rubik","Nunito",system-ui,sans-serif;--fb:"Manrope",system-ui,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,h4{font-family:var(--fh);letter-spacing:-.015em;line-height:1.15;margin:0;font-weight:700}
.wrap{max-width:1180px;margin:0 auto;padding:0 22px}
.mark{background:linear-gradient(transparent 62%,var(--sun) 62%);padding:0 3px;border-radius:3px;color:inherit}
/* ---------- меню ---------- */
.top{position:sticky;top:0;z-index:50;background:rgba(251,245,234,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.top .in{max-width:1180px;margin:0 auto;padding:9px 22px;display:flex;align-items:center;gap:18px;min-height:68px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;margin-right:auto;white-space:nowrap}
.logo .mono{width:44px;height:44px;border-radius:14px;background:var(--teal);color:#fff;font-family:var(--fh);font-weight:700;font-size:17px;display:grid;place-items:center}
.logo b{font-family:var(--fh);font-weight:700;font-size:16.5px;line-height:1.1;display:block}
.logo small{font-size:12.5px;color:var(--muted);font-weight:500;display:block}
.nav{display:flex;align-items:center;gap:2px}
.nav>a,.nav .dd>button{font:inherit;font-weight:600;font-size:15px;color:var(--ink);text-decoration:none;background:none;border:0;padding:9px 13px;border-radius:999px;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:5px;transition:background .2s}
.nav>a:hover,.nav .dd>button:hover,.nav a.on,.nav .dd.on>button{background:var(--teal-soft)}
.nav>a.btn{color:#fff;background:var(--terra)}
.nav>a.btn:hover{background:var(--terra-d)}
.nav>a.games{background:var(--sun);color:#3a2a08;font-weight:800;margin:0 4px}
.nav>a.games:hover{background:#f7cd67}
.dd{position:relative}
.dd>button svg{width:14px;height:14px;transition:transform .2s}
.dd:hover>button svg,.dd.open>button svg{transform:rotate(180deg)}
.menu{position:absolute;top:100%;left:0;min-width:300px;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);padding:8px;opacity:0;visibility:hidden;transform:translateY(6px);transition:.2s var(--ease)}
.dd:hover .menu,.dd.open .menu,.dd:focus-within .menu{opacity:1;visibility:visible;transform:none}
.menu a{display:block;text-decoration:none;padding:10px 14px;border-radius:14px;transition:background .15s}
.menu a:hover{background:var(--teal-soft)}
.menu b{display:block;font-family:var(--fh);font-size:15px;font-weight:600}.menu span{font-size:13px;color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:inherit;font-weight:700;font-size:16px;text-decoration:none;color:#fff;background:var(--terra);padding:14px 26px;border-radius:999px;border:0;cursor:pointer;box-shadow:0 14px 28px -14px rgba(217,112,60,.85);transition:transform .25s var(--ease),background .2s}
.btn:hover{transform:translateY(-2px);background:var(--terra-d)}
.btn svg{width:18px;height:18px}
.btn.line{background:#fff;color:var(--ink);border:1.5px solid var(--line);box-shadow:none}
.btn.line:hover{background:var(--teal-soft)}
.btn.sun{background:var(--sun);color:#3a2a08;box-shadow:0 14px 28px -14px rgba(220,160,30,.9)}.btn.sun:hover{background:#f7cd67}
.btn.dk{background:var(--teal);box-shadow:0 14px 28px -14px rgba(31,91,94,.9)}.btn.dk:hover{background:var(--teal-d)}
.btn.sm{padding:10px 18px;font-size:14.5px}
.btn.big{padding:17px 32px;font-size:17px}
.burger{display:none;width:46px;height:46px;border-radius:14px;border:1px solid var(--line);background:#fff;cursor:pointer;color:var(--ink)}
.burger svg{width:22px;height:22px}
@media (max-width:1060px){
  .burger{display:grid;place-items:center}
  .nav{position:fixed;left:0;right:0;top:68px;bottom:0;background:var(--bg);flex-direction:column;align-items:stretch;gap:8px;padding:16px 22px 100px;overflow:auto;transform:translateX(100%);transition:transform .3s var(--ease)}
  .top.open .nav{transform:none}
  .nav>a,.nav .dd>button{font-size:19px;padding:15px 18px;background:#fff;border:1px solid var(--line);width:100%;justify-content:space-between;border-radius:18px}
  .nav>a.games{margin:0;background:var(--sun)}
  .nav>a.btn{justify-content:center;border:0}
  .menu{position:static;opacity:1;visibility:visible;transform:none;box-shadow:none;border:0;background:transparent;padding:4px 0 6px 10px;min-width:0;display:none}
  .dd.open .menu{display:block}
  .nav .btn{margin-top:8px;margin-left:0!important}
}
/* ---------- секции и полосы ---------- */
section{margin-top:84px}
.band{position:relative;isolation:isolate;margin-top:0;padding:88px 0}
.band::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);z-index:-1;background:var(--bg)}
.band.white::before{background:#fff}.band.sand::before{background:var(--sand)}.band.sage::before{background:var(--teal-soft)}
.band.sun::before{background:var(--sun-soft)}.band.dark::before{background:var(--teal)}.band.terra::before{background:var(--terra)}
.band.dark{color:#fff}.band.dark h2,.band.dark h3{color:#fff}.band.dark .sub{color:rgba(255,255,255,.82)}.band.dark .kick{color:var(--sun)}
.band.terra{color:#fff}.band.terra h2{color:#fff}.band.terra .sub{color:rgba(255,255,255,.92)}.band.terra .kick{color:#fff}
.kick{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--terra-d);margin-bottom:12px}
.kick::before{content:"";width:24px;height:3px;border-radius:3px;background:currentColor}
h2{font-size:clamp(28px,3.8vw,42px)}
.sub{color:var(--muted);font-size:18px;max-width:700px;margin:14px 0 0}
.head{margin-bottom:38px}
.hero{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:36px;align-items:center;padding-top:34px;padding-bottom:70px}
.hero h1{font-size:clamp(34px,4.6vw,56px);font-weight:700;line-height:1.1}
.lead{font-size:clamp(17px,2vw,20px);color:var(--muted);margin:20px 0 28px;max-width:560px}
.eyebrow{display:inline-block;font-weight:700;font-size:13px;letter-spacing:.07em;text-transform:uppercase;color:var(--teal);background:var(--teal-soft);border-radius:999px;padding:7px 15px;margin-bottom:20px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.trust{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 22px;margin-top:34px;max-width:540px}
.trust div{display:flex;gap:11px;align-items:center;font-weight:600;font-size:15px;line-height:1.3}
.trust i{flex:none;width:38px;height:38px;border-radius:12px;background:var(--teal-soft);color:var(--teal);display:grid;place-items:center}
.trust i svg{width:20px;height:20px}
/* портрет: арка + жёлтый круг + глиняная Александра-проводник */
.portrait{position:relative;max-width:470px;margin:0 auto;width:100%}
.portrait .sunc{position:absolute;width:82%;aspect-ratio:1;border-radius:50%;background:var(--sun);right:-8%;top:2%;z-index:0}
.portrait .ph{position:relative;z-index:1;border-radius:999px 999px 30px 30px;overflow:hidden;aspect-ratio:4/5;background:#d6b995;box-shadow:var(--shadow);margin-left:12%}
.portrait .ph img{width:100%;height:100%;object-fit:cover;object-position:60% 22%}
.portrait .mascot{position:absolute;z-index:3;left:-6%;bottom:-3%;width:34%;filter:drop-shadow(0 14px 16px rgba(29,43,51,.28));animation:bob 4.4s ease-in-out infinite;transform-origin:bottom center}
.fb{position:absolute;z-index:4;display:flex;align-items:center;gap:10px;background:#fff;border-radius:16px;padding:10px 15px;box-shadow:0 18px 34px -18px rgba(29,43,51,.5);font-weight:700;font-size:14px;line-height:1.25;animation:float 6s ease-in-out infinite}
.fb i{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;flex:none;background:var(--teal-soft);color:var(--teal)}
.fb i svg{width:18px;height:18px}
.fb small{display:block;font-weight:500;color:var(--muted);font-size:12px}
.fb.a{right:-2%;top:12%}.fb.c{right:2%;bottom:9%;animation-delay:2s}
@keyframes float{50%{transform:translateY(-8px)}}
@keyframes bob{50%{transform:translateY(-8px) rotate(1.5deg)}}
@media (max-width:900px){.hero{grid-template-columns:1fr;gap:38px;padding-top:22px}.portrait{max-width:400px}.trust{max-width:none}}
/* ---------- карточки ---------- */
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:transform .3s var(--ease),box-shadow .3s;position:relative}
a.card{text-decoration:none;display:block;color:inherit}
a.card:hover,.card.h:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.ico{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;margin-bottom:16px;background:var(--teal-soft);color:var(--teal)}
.ico svg{width:27px;height:27px}
.card h3{font-size:20px;margin-bottom:8px}
.card p{margin:0;color:var(--muted);font-size:15.5px}
.more{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-weight:800;color:var(--terra-d);font-size:15px}
.more svg{width:16px;height:16px;transition:transform .2s}.card:hover .more svg{transform:translateX(4px)}
/* карточки «с чем пришли» с глиняным героем */
.case{display:flex;flex-direction:column;padding:0;overflow:hidden}
.case .pic{height:170px;display:grid;place-items:end center;background:var(--teal-soft);position:relative;overflow:hidden}
.case:nth-child(2) .pic{background:var(--sun-soft)}.case:nth-child(3) .pic{background:var(--terra-soft)}
.case .pic img{height:88%;width:auto;object-fit:contain;animation:bob 5s ease-in-out infinite}
.case .body{padding:24px 26px 28px;display:flex;flex-direction:column;flex:1}
.case h3{font-size:22px}
.case .signs{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:7px;color:var(--muted);font-size:15px}
.case .signs li{display:flex;gap:9px}.case .signs li::before{content:"";flex:none;width:7px;height:7px;border-radius:50%;background:var(--terra);margin-top:9px}
.case .do{margin-top:14px;padding-top:14px;border-top:1px dashed var(--line);font-size:15px;color:var(--ink)}
.case .do b{color:var(--teal)}
.case .more{margin-top:auto;padding-top:16px}
/* ---------- упражнения ---------- */
.gblock{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center}
.gblock h2{font-size:clamp(28px,3.6vw,42px)}
.gblock p{font-size:18px;margin:14px 0 22px;color:#5a4a22}
.ggroups{display:grid;gap:12px;margin-bottom:26px}
.ggroup{background:rgba(255,255,255,.72);border-radius:18px;padding:13px 16px}
.ggroup b{display:block;font-family:var(--fh);font-size:15px;margin-bottom:7px;color:#3a2a08}
.gchips{display:flex;gap:7px;flex-wrap:wrap}
.gchips a{text-decoration:none;background:#fff;border-radius:999px;padding:6px 13px;font-weight:600;font-size:14px;color:#3a2a08;transition:transform .2s,background .2s;border:1px solid rgba(58,42,8,.08)}
.gchips a:hover{transform:translateY(-2px);background:var(--sun)}
.gtiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.gt{display:grid;place-items:center;aspect-ratio:1;border-radius:26px;background:#fff;box-shadow:0 18px 34px -22px rgba(120,70,20,.6);transition:transform .35s var(--ease);padding:12%;min-width:0;overflow:hidden}
.gt:hover{transform:translateY(-6px) rotate(-2deg)}
.gt img{width:100%;height:100%;object-fit:contain;animation:bob 3.4s ease-in-out infinite}
.gt.t1{background:#d9efd0}.gt.t2{background:#cfe8f7}.gt.t3{background:#fff4d6}.gt.t4{background:#d7ecfa}.gt.t5{background:#ffe3c2}.gt.t6{background:#f6e0d3}
.gt.t2 img{animation:sway 4s ease-in-out infinite}.gt.t3 img{animation:drive 3s ease-in-out infinite}
.gt.t4 img{animation:bob 4.4s ease-in-out infinite .4s}.gt.t5 img{animation:pulse 2.8s ease-in-out infinite}
.gt.t6 img{animation:drive 3.6s ease-in-out infinite .6s}.gt.t1 img{animation:wiggle 3.2s ease-in-out infinite}
@keyframes sway{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg) translateY(-4px)}}
@keyframes drive{0%,100%{transform:translateX(-6px)}50%{transform:translateX(6px)}}
@keyframes pulse{50%{transform:scale(1.1)}}
@keyframes wiggle{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg) translateY(-5px)}}
@media (max-width:900px){.gblock{grid-template-columns:1fr}.gtiles{gap:10px}}
/* ---------- этапы ---------- */
.steps{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));counter-reset:s}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;position:relative;counter-increment:s;transition:transform .3s var(--ease)}
.step:hover{transform:translateY(-4px)}
.step::before{content:counter(s);font-family:var(--fh);font-weight:700;font-size:20px;color:#fff;background:var(--teal);width:42px;height:42px;border-radius:50%;display:grid;place-items:center;margin-bottom:14px}
.step h3{font-size:18px;margin-bottom:6px}.step p{margin:0;color:var(--muted);font-size:15px}
.band.dark .step{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.16)}
.band.dark .step::before{background:var(--sun);color:#3a2a08}
.band.dark .step p{color:rgba(255,255,255,.8)}
.how{display:grid;grid-template-columns:1fr 200px;gap:30px;align-items:end}
.how img{width:100%;animation:bob 5s ease-in-out infinite;filter:drop-shadow(0 16px 18px rgba(0,0,0,.25))}
@media (max-width:860px){.how{grid-template-columns:1fr}.how img{max-width:150px;order:-1}}
/* ---------- два столбца, панели ---------- */
.two{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}
@media (max-width:860px){.two{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:30px;padding:34px;box-shadow:var(--shadow)}
.panel.soft{background:var(--terra-soft);border-color:transparent;box-shadow:none}
.panel.sage{background:var(--teal-soft);border-color:transparent;box-shadow:none}
.list{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:12px}
.list li{display:flex;gap:11px;align-items:flex-start;font-weight:500}
.list svg{flex:none;width:21px;height:21px;color:var(--teal);margin-top:3px}
.list.x svg{color:var(--terra-d)}
.ticks{list-style:none;margin:26px 0 0;padding:0;display:grid;gap:10px}
.ticks li{display:flex;gap:11px;align-items:flex-start;font-weight:600;font-size:16px}
.ticks svg{flex:none;width:22px;height:22px;color:var(--teal);margin-top:2px}
.vis{border-radius:32px;aspect-ratio:4/3;display:grid;place-items:center;text-align:center;padding:26px;background:var(--teal-soft);position:relative;overflow:hidden}
.vis.m{background:var(--sun-soft)}.vis.l{background:var(--terra-soft)}
.vis .big{width:90px;height:90px;border-radius:28px;background:#fff;display:grid;place-items:center;color:var(--teal);box-shadow:var(--shadow);margin:0 auto 16px}
.vis .big svg{width:44px;height:44px}
.vis b{font-family:var(--fh);font-size:21px;display:block;max-width:300px;margin:0 auto;font-weight:600}
.vis span{display:block;color:var(--muted);font-size:15px;margin-top:6px}
.vis img{height:170px;width:auto;margin:0 auto 10px;animation:bob 5s ease-in-out infinite}
/* ---------- форматы и цены ---------- */
.rows{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);overflow:hidden}
.row{display:grid;grid-template-columns:1.2fr 2fr auto;gap:18px;align-items:center;padding:20px 26px;border-top:1px solid var(--line);transition:background .2s}
.row:hover{background:var(--bg)}
.row:first-child{border-top:0}
.row b{font-family:var(--fh);font-size:18px;font-weight:600}.row span{color:var(--muted);font-size:15px}
.price{font-family:var(--fh);font-weight:700;font-size:20px;white-space:nowrap}
.price small{display:block;font-family:var(--fb);font-weight:500;font-size:12.5px;color:var(--muted);text-align:right}
@media (max-width:760px){.row{grid-template-columns:1fr;gap:6px}.price small{text-align:left}}
/* ---------- доказательства ---------- */
.cred{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.cred div{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px}
.cred b{font-family:var(--fh);font-weight:700;font-size:26px;color:var(--teal);display:block;line-height:1.1}
.cred span{display:block;margin-top:8px;color:var(--muted);font-size:15px}
.revs{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:22px}
.rev{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px}
.rev q{display:block;quotes:none;font-size:16px;line-height:1.55}
.rev small{display:block;margin-top:12px;color:var(--muted);font-weight:600}
.todo{outline:2px dashed var(--terra);outline-offset:6px;border-radius:14px}
.note{color:var(--muted);font-size:14.5px;margin-top:12px}
.note.light{color:rgba(255,255,255,.75)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px}
.stat b{font-family:var(--fh);font-size:34px;color:var(--teal);display:block;line-height:1}
.stat span{color:var(--muted);font-size:14.5px;display:block;margin-top:8px}
/* ---------- о себе ---------- */
.person{display:grid;grid-template-columns:.8fr 1.2fr;gap:34px;align-items:center}
.person .ph{border-radius:999px 999px 28px 28px;overflow:hidden;aspect-ratio:4/5;background:#d6b995}
.person .ph img{width:100%;height:100%;object-fit:cover;object-position:60% 22%}
.roles{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 18px}
.role{display:inline-flex;align-items:center;gap:7px;font-weight:700;font-size:14px;padding:7px 14px;border-radius:999px;background:var(--teal-soft);color:var(--teal)}
@media (max-width:700px){.person{grid-template-columns:1fr}.person .ph{max-width:320px}}
/* ---------- FAQ ---------- */
.faq{display:grid;gap:12px}
.faq details{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:0 24px;transition:box-shadow .2s}
.faq details[open]{box-shadow:var(--shadow)}
.faq summary{cursor:pointer;list-style:none;font-family:var(--fh);font-weight:600;font-size:18px;padding:20px 0;display:flex;justify-content:space-between;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:28px;line-height:1;color:var(--terra);transition:transform .2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{margin:0 0 20px;color:var(--muted)}
/* ---------- запись ---------- */
.cta2{display:grid;grid-template-columns:1fr 170px;gap:30px;align-items:center}
.cta2 img{width:100%;animation:bob 4.6s ease-in-out infinite;filter:drop-shadow(0 16px 18px rgba(0,0,0,.25))}
@media (max-width:760px){.cta2{grid-template-columns:1fr}.cta2 img{max-width:120px;order:-1}}
.social{display:flex;gap:12px;flex-wrap:wrap}
.sbtn,.sbtn.vk,.sbtn.tg,.sbtn.ig,.sbtn.yt{display:inline-flex;align-items:center;gap:10px;text-decoration:none;background:#fff;color:var(--ink);font-weight:700;border-radius:999px;padding:13px 22px 13px 16px;border:1px solid var(--line);box-shadow:0 12px 24px -16px rgba(29,43,51,.5);transition:transform .25s var(--ease)}
.sbtn:hover{transform:translateY(-3px)}
.sbtn svg{width:24px;height:24px;fill:currentColor}
.sbtn.vk{order:-1}.sbtn.vk svg{color:#0077ff}.sbtn.tg svg{color:#2aabee}.sbtn.ig svg{color:#e1306c}.sbtn.yt svg{color:#ff2d2d}
/* ---------- баннеры внутренних страниц ---------- */
.banner{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center;border-radius:34px;padding:44px;background:var(--teal);color:#fff;overflow:hidden}
.banner h2{color:#fff;font-size:clamp(26px,3.4vw,36px)}.banner p{color:rgba(255,255,255,.85);margin:14px 0 22px;max-width:520px}
.banner .kick{color:var(--sun)}
.banner.warm{background:var(--sun-soft);color:var(--ink)}.banner.warm h2{color:var(--ink)}.banner.warm p{color:var(--muted)}.banner.warm .kick{color:var(--terra-d)}
@media (max-width:860px){.banner{grid-template-columns:1fr;padding:28px}}
/* ---------- шапка внутренней страницы ---------- */
.phead{margin-top:30px;padding:44px 44px 40px;border-radius:34px;background:var(--teal-soft);position:relative;overflow:hidden}
.phead::after{content:"";position:absolute;right:-70px;top:-70px;width:260px;height:260px;border-radius:50%;background:var(--sun-soft)}
.phead>*{position:relative;z-index:1}
.phead h1{font-size:clamp(32px,4.6vw,50px)}
.phead .lead{margin-bottom:24px}
.crumbs{font-size:14px;color:var(--muted);margin-bottom:16px}.crumbs a{text-decoration:none}.crumbs a:hover{color:var(--ink)}
.pgrid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
@media (max-width:860px){.pgrid{grid-template-columns:1fr}.phead{padding:28px 22px}}
/* ---------- подвал и нижняя панель ---------- */
footer{margin-top:0;background:var(--teal-d);color:#d5e3e1;padding:56px 0 90px}
footer .cols{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:34px}
footer h4{color:#fff;font-size:16px;margin-bottom:12px}
footer a{display:block;color:#d5e3e1;text-decoration:none;padding:4px 0;font-size:15px}footer a:hover{color:#fff}
footer .legal{margin-top:34px;padding-top:20px;border-top:1px solid rgba(255,255,255,.14);font-size:13.5px;color:#9fb8b5}
@media (max-width:760px){footer .cols{grid-template-columns:1fr}}
.dock{position:fixed;left:10px;right:10px;bottom:10px;z-index:40;display:none;gap:8px;padding:8px;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}
.dock a{flex:1;text-align:center;text-decoration:none;font-weight:800;font-size:14.5px;padding:12px 8px;border-radius:17px;color:#fff}
.dock .v{background:#0077ff}.dock .g{background:var(--sun);color:#3a2a08}.dock .a{background:var(--terra)}
@media (max-width:760px){.dock{display:flex}body{padding-bottom:84px}}
.rv{opacity:0;transform:translateY(22px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}.rv{opacity:1;transform:none}}
@media (max-width:760px){section{margin-top:64px}.band{padding:58px 0}.hero{padding-bottom:50px}body{font-size:16.5px}.card,.panel{padding:24px}.case{padding:0}.banner{padding:26px}}

.gt{display:flex;flex-direction:column;justify-content:center;gap:8px;padding:12% 8% 9%}
.gt img{height:auto;flex:1;min-height:0}
.gt em{font-style:normal;font-weight:700;font-size:12.5px;line-height:1.2;text-align:center;color:#3a2a08}

.case .pic{height:200px;display:flex;justify-content:center;align-items:flex-end;padding-top:14px}
.case .pic img{height:100%;width:auto;max-width:none}
.gt{text-decoration:none}
.hero .cta .btn.big{padding:16px 26px;font-size:16px}

/* v4.2 */
.hero h1 .hl{font-style:normal;background:linear-gradient(transparent 64%,var(--sun) 64%);padding:0 5px;margin:0 -5px;border-radius:4px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.hero .fb.c{left:2%;right:auto;bottom:5%}
.case .pic{height:auto;aspect-ratio:4/3;padding:0;display:block}
.case .pic img{width:100%;height:100%;object-fit:cover;max-width:100%;animation:none}
.signup{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin:26px 0 30px}
.s1{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);border-radius:22px;padding:20px}
.s1 b{flex:none;width:40px;height:40px;border-radius:50%;background:#fff;color:var(--terra-d);display:grid;place-items:center;font-family:var(--fh);font-size:19px}
.s1 span{font-weight:600;line-height:1.4}
.bigcta{display:flex;gap:14px;flex-wrap:wrap}
.btn.xl{padding:22px 40px;font-size:19px}
.btn.white{background:#fff;color:var(--terra-d);box-shadow:0 18px 34px -16px rgba(0,0,0,.4)}.btn.white:hover{background:#fff7ee}
.btn.dkb{background:var(--teal-d);box-shadow:0 18px 34px -16px rgba(0,0,0,.4)}.btn.dkb:hover{background:#0f3436}
body.pub .todo,body.pub .revs,body.pub .stat.todo{display:none!important}
.hero .cta{margin-bottom:6px}

/* ===================== v5: палитра заказчика, Onest + Inter ===================== */
:root{
  --bg:#FAF5EB;--ink:#193449;--muted:#55697a;--line:rgba(25,52,73,.11);
  --teal:#194F52;--teal-d:#123c3f;--teal-soft:#DFEEE9;
  --terra:#C4561F;--terra-d:#A9461A;--terra-hi:#E16D38;--terra-soft:#F9E4D5;
  --sun:#F7C64B;--sun-soft:#FCEFC8;--sand:#F3E7D3;
  --fh:"Onest","Rubik",system-ui,sans-serif;--fb:"Inter","Manrope",system-ui,sans-serif;
}
body{font-family:var(--fb);font-size:17px;line-height:1.6}
h1,h2,h3,h4,.logo b,.btn,.step h3,.more{font-family:var(--fh)}
h1,h2{text-wrap:balance;font-weight:700;letter-spacing:-.02em}
h3{text-wrap:balance}
.band.mint::before{background:#DFEEE9}.band.peach::before{background:#F9E4D5}
.band.dark::before{background:#194F52}.band.terra::before{background:linear-gradient(120deg,#D9632E,#B84B1B)}
.kick{color:var(--terra)}
.logo .mono{background:var(--teal)}
.nav>a.btn{background:var(--terra)}
.btn.ghostb{background:transparent;color:var(--ink);border:1.5px solid rgba(25,52,73,.25);box-shadow:none}
.btn.ghostb:hover{background:#fff}
/* hero v5 */
.hero5{display:grid;grid-template-columns:1.05fr .95fr;gap:20px;align-items:end;padding:6px 0 0;min-height:560px}
.hero5 h1{font-size:clamp(34px,4.5vw,56px);line-height:1.06;max-width:620px}
.hero5 .lead{max-width:540px}
.hero5>div:first-child{align-self:center;padding-bottom:50px}
.facts{display:flex;gap:30px;flex-wrap:wrap;margin-top:34px;padding-top:24px;border-top:1px solid var(--line)}
.facts b{display:block;font-family:var(--fh);font-size:24px;color:var(--teal)}
.facts span{font-size:14px;color:var(--muted)}
.hero5pic{position:relative;align-self:end;max-width:520px;margin:0 auto;width:100%}
.hero5pic .shape{position:absolute;left:6%;right:2%;bottom:0;top:18%;border-radius:200px 200px 32px 32px;background:linear-gradient(160deg,#DFEEE9,#F9E4D5)}
.hero5pic img{position:relative;z-index:1;width:100%;height:auto;display:block}
.tagcard{position:absolute;z-index:2;left:-4%;bottom:6%;background:#fff;border-radius:16px;padding:12px 16px;box-shadow:0 18px 34px -18px rgba(25,52,73,.5);max-width:250px}
.tagcard b{font-family:var(--fh);font-size:15px;display:block}
.tagcard span{font-size:12.5px;color:var(--muted);line-height:1.35;display:block;margin-top:2px}
.hero5+.band{margin-top:0}
@media (max-width:900px){.hero5{grid-template-columns:1fr;min-height:0;gap:10px}.hero5>div:first-child{padding-bottom:10px}.hero5pic{max-width:380px}.tagcard{left:0}}
/* ситуации */
.case .signs{margin-bottom:6px}
/* особенности развития */
.devgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.dev{background:#fff;border-radius:22px;padding:24px;display:flex;flex-direction:column}
.dev h3{font-size:18px;margin-bottom:10px;color:var(--teal)}
.dev ul{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:6px;font-size:14.5px;color:var(--muted)}
.dev li{padding-left:14px;position:relative}.dev li::before{content:"";position:absolute;left:0;top:.62em;width:5px;height:5px;border-radius:50%;background:var(--terra-hi)}
.dev a{margin-top:auto;font-weight:700;font-size:14.5px;text-decoration:none;color:var(--terra);display:inline-flex;gap:6px;align-items:center}
.dev a svg{width:15px;height:15px}
/* схема этапов */
.flow{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;position:relative;counter-reset:f}
.flow::before{content:"";position:absolute;left:4%;right:4%;top:22px;height:2px;background:repeating-linear-gradient(90deg,var(--teal) 0 8px,transparent 8px 16px);opacity:.35}
.flow li{position:relative;padding:0 10px;text-align:left}
.flow i{font-style:normal;width:44px;height:44px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;font-family:var(--fh);font-weight:700;margin-bottom:14px;position:relative}
.flow li:nth-child(n+4) i{background:var(--terra)}
.flow b{display:block;font-family:var(--fh);font-size:17px;margin-bottom:5px}
.flow span{display:block;font-size:14px;color:var(--muted);line-height:1.5}
@media (max-width:900px){.flow{grid-template-columns:1fr;gap:18px}.flow::before{left:21px;right:auto;top:10px;bottom:10px;width:2px;height:auto;background:repeating-linear-gradient(180deg,var(--teal) 0 8px,transparent 8px 16px)}.flow li{padding-left:64px;min-height:44px}.flow i{position:absolute;left:0;top:0;margin:0}}
/* форматы */
.fmt{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch}
.fcol{background:#fff;border:1px solid var(--line);border-radius:26px;padding:28px;display:flex;flex-direction:column}
.fcol.main{background:var(--teal);color:#fff;border-color:transparent;transform:translateY(-8px);box-shadow:0 30px 50px -30px rgba(25,79,82,.8)}
.fk{font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--terra);margin-bottom:8px}
.fcol.main .fk{color:var(--sun)}
.fcol h3{font-size:22px;margin-bottom:8px}.fd{margin:0 0 14px;color:var(--muted)}.fcol.main .fd{color:rgba(255,255,255,.8)}
.fcol ul{margin:0 0 16px;padding:0 0 0 18px;display:grid;gap:7px;font-size:15px}
.fp{margin-top:auto;font-size:14px;font-weight:600;padding:10px 0 14px;color:var(--muted)}.fcol.main .fp{color:rgba(255,255,255,.75)}
.fcol .btn{align-self:flex-start}
@media (max-width:900px){.fmt{grid-template-columns:1fr}.fcol.main{transform:none}}
/* продукты */
.prods{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:18px;align-items:stretch}
.prod{background:#fff;border-radius:26px;overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .3s var(--ease),box-shadow .3s}
.prod:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.prod>img{width:100%;aspect-ratio:3/2;object-fit:cover}
.pb{padding:22px 24px 24px;display:flex;flex-direction:column;flex:1}
.pb h3{font-size:21px;margin-bottom:6px}.pb p{margin:0;color:var(--muted);font-size:15px}
.pk{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--terra);display:block;margin-bottom:6px}
.pr{margin-top:auto;padding-top:16px;display:flex;justify-content:space-between;align-items:center}
.pr b{font-family:var(--fh);font-size:22px;color:var(--teal)}
.cover{aspect-ratio:3/2;padding:22px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff}
.cover span{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.85;margin-bottom:8px}
.cover b{font-family:var(--fh);font-size:22px;line-height:1.15}
.cover em{font-style:normal;font-size:14px;opacity:.85;margin-top:6px}
.c-t{background:linear-gradient(150deg,#194F52,#2a7b7a)}.c-b{background:linear-gradient(150deg,#B84B1B,#E16D38)}
.cover.big{aspect-ratio:4/3;border-radius:26px;padding:34px}.cover.big b{font-size:clamp(26px,3.4vw,38px)}
@media (max-width:900px){.prods{grid-template-columns:1fr}}
/* об Александре */
.aboutw{display:grid;grid-template-columns:.8fr 1.2fr;gap:36px;align-items:end}
.ap img{width:100%;max-width:420px;margin:0 auto}
.band.dark.aboutwb{padding-bottom:0}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.chips span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:7px 14px;font-size:14px;font-weight:600}
@media (max-width:860px){.aboutw{grid-template-columns:1fr}.ap{order:2}}
/* игры: компактно */
.gstrip{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center}
.gstrip h2{font-size:clamp(24px,3vw,34px)}.gstrip p{color:#5a4a22;margin:10px 0 18px;max-width:520px}
.exmini{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.exmini a{background:#fff;border-radius:20px;aspect-ratio:1;display:grid;place-items:center;padding:14%;transition:transform .3s var(--ease)}
.exmini a:hover{transform:translateY(-5px) rotate(-2deg)}
.exmini img{width:100%;height:100%;object-fit:contain;animation:bob 3.6s ease-in-out infinite}
@media (max-width:860px){.gstrip{grid-template-columns:1fr}}
/* отзывы */
.revs2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}
.rev2{margin:0;background:var(--bg);border-radius:24px;padding:28px;position:relative}
.rev2::before{content:"“";position:absolute;right:22px;top:6px;font-family:var(--fh);font-size:80px;line-height:1;color:var(--terra-hi);opacity:.4}
.rev2 blockquote{margin:0;font-size:17px;line-height:1.6}
.rev2 figcaption{margin-top:14px;color:var(--muted);font-size:14px;font-weight:600}
/* индивидуальная работа */
.prigrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.pr1{display:flex;gap:16px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:22px;padding:20px 22px;text-decoration:none;color:inherit;transition:transform .3s var(--ease),box-shadow .3s}
.pr1:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.pr1 i{font-style:normal;flex:none;width:44px;height:44px;border-radius:14px;background:var(--terra-soft);color:var(--terra);display:grid;place-items:center;font-family:var(--fh);font-weight:700;font-size:20px}
.pr1 h3{font-size:18px}.pr1 p{margin:3px 0 0;font-size:14px;color:var(--muted)}
.pr1 span svg{width:20px;height:20px;color:var(--terra)}.pr1 div{flex:1}
.fsec{margin-top:70px;position:relative;isolation:isolate;padding:56px 0}
.fsec::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);z-index:-1;background:transparent}
.fsec.dark2::before{background:var(--teal)}
.fsec.dark2{color:#fff}.fsec.dark2 h2{color:#fff}.fsec.dark2 .sub{color:rgba(255,255,255,.8)}.fsec.dark2 .kick{color:var(--sun)}
.fgrid{display:grid;grid-template-columns:1fr 1.1fr;gap:44px;align-items:start}
.fcost{display:inline-block;margin-top:18px;font-weight:700;font-size:15px;background:var(--terra-soft);color:var(--ink);padding:9px 16px;border-radius:999px}
.dark2 .fcost{background:rgba(255,255,255,.12);color:#fff}
.fcard{background:#fff;color:var(--ink);border-radius:26px;padding:28px;box-shadow:var(--shadow)}
.fcard .fh{font-family:var(--fh);font-weight:700;font-size:15px;color:var(--terra);margin:18px 0 0}.fcard .fh:first-child{margin-top:0}
.fcard .list{margin-top:8px}
.choose{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.choose div{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px 22px}
.choose b{display:block;font-family:var(--fh);font-size:17px;margin-bottom:6px}.choose span{color:var(--terra);font-weight:700;font-size:15px}
@media (max-width:860px){.fgrid{grid-template-columns:1fr}.fsec{margin-top:50px}}
.panel.cta3{background:var(--teal);color:#fff;border:0}.panel.cta3 h2{color:#fff}.panel.cta3 .sub{color:rgba(255,255,255,.8)}
/* страницы продуктов */
.pvis{border-radius:30px;overflow:hidden;background:var(--teal-soft);display:grid;place-items:center;padding:18px}
.pvis.s{background:var(--terra-soft)}.pvis.l{background:var(--sun-soft)}
.pvis img{border-radius:18px;width:100%;box-shadow:0 24px 44px -24px rgba(25,52,73,.6)}
.pvis .cover{width:100%;border-radius:22px}
.mats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0 12px}
.mats div{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px}
.mats b{display:block;font-family:var(--fh);font-size:20px;color:var(--teal)}.mats span{font-size:14px;color:var(--muted)}
.buybox{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:var(--terra-soft);border-radius:30px;padding:36px 40px}
.bprice{font-family:var(--fh);font-size:clamp(34px,5vw,52px);font-weight:700;color:var(--teal);line-height:1}
@media (max-width:760px){.buybox{grid-template-columns:1fr;padding:26px}}
@media (max-width:760px){.band{padding:56px 0}.hero5 h1{font-size:34px}}
